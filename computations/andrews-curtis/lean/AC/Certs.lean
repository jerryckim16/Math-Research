    .cycle .r1 3]

theorem p1_ms_check :
    check (MS 2 [X, X, Y, x, x, y]) (p1_ms_pre ++ p1_ms_post) (johnsonP1) = true := by
  decide +kernel

/-- P1 = MS(2, x⁻² y⁻¹ x² y) ~AC Johnson's P1 (rotation of the second relator). -/
theorem p1_ms : ACEquiv (MS 2 [X, X, Y, x, x, y]) (johnsonP1) :=
  (check_sound p1_ms_check)

/-! ## Negative controls (kernel evaluates `check` to `false`) -/

/-- Theorem 4 certificate with move 0 corrupted to `['cycle', 0, 7]`. -/
theorem neg_thm4_move0 :
    check (MS 3 [Y, x, x, Y]) (thm4_pre ++ [
    .cycle .r0 7, .mul .r1 false, .conj .r0 Y, .mul .r1 true, .cycle .r1 2, .conj .r0 x,
    .mul .r0 false, .cycle .r0 4, .invert .r1, .cycle .r1 4, .mul .r1 true, .conj .r1 X,
    .mul .r1 true] ++ thm4_post) (AK 3) = false := by
  decide +kernel

/-- Theorem 4 certificate with move 5 corrupted to `['conj', 0, -1]`. -/
theorem neg_thm4_move5 :
    check (MS 3 [Y, x, x, Y]) (thm4_pre ++ [
    .cycle .r0 6, .mul .r1 false, .conj .r0 Y, .mul .r1 true, .cycle .r1 2, .conj .r0 X,
    .mul .r0 false, .cycle .r0 4, .invert .r1, .cycle .r1 4, .mul .r1 true, .conj .r1 X,
    .mul .r1 true] ++ thm4_post) (AK 3) = false := by
  decide +kernel

/-- Theorem 4 certificate with move 12 corrupted to `['mul', 1, 0, -1]`. -/
theorem neg_thm4_move12 :
    check (MS 3 [Y, x, x, Y]) (thm4_pre ++ [
    .cycle .r0 6, .mul .r1 false, .conj .r0 Y, .mul .r1 true, .cycle .r1 2, .conj .r0 x,
    .mul .r0 false, .cycle .r0 4, .invert .r1, .cycle .r1 4, .mul .r1 true, .conj .r1 X,
    .mul .r1 false] ++ thm4_post) (AK 3) = false := by
  decide +kernel

/-- Correct Theorem 4 chain, wrong target AK(2). -/
theorem neg_thm4_target :
    check (MS 3 [Y, x, x, Y]) (thm4_pre ++ thm4_cert ++ thm4_post) (AK 2) = false := by
  decide +kernel

/-- Correct Theorem 4 chain, wrong source MS(3, y x² y). -/
theorem neg_thm4_source :
    check (MS 3 [y, x, x, y]) (thm4_pre ++ thm4_cert ++ thm4_post) (AK 3) = false := by
  decide +kernel

end AC
