/-!
# Andrews–Curtis moves on rank-2 balanced presentations (definitions)

Plain Lean 4 core, no Mathlib.  This file fixes *what* is being claimed; the
checker and its soundness proof are in `AC/Checker.lean`.

* A word is a list of letters `x, X = x⁻¹, y, Y = y⁻¹`.
* `FreeEq` is the equivalence relation on words generated by deleting a
  cancelling pair `a a⁻¹` anywhere (`p ++ a :: a⁻¹ :: q ~ p ++ q`).  Words up
  to `FreeEq` are the elements of the free group F(x, y) (standard
  construction); nothing below depends on the uniqueness of reduced forms.
* A presentation `⟨x, y | r₀, r₁⟩` is a pair of words.
* `ACStep` is one AC move, exactly as in the Statement section of
  `problems/andrews-curtis.md`:
    r_i ← r_i⁻¹;   r_i ← r_i r_j^{±1} (j ≠ i);   r_i ← w r_i w⁻¹ (w any word);
  plus replacing a relator by a freely equal word (the moves act on group
  elements, words are only names for them).
* `ACEquiv` is the reflexive–transitive closure of `ACStep`.  It is proved
  symmetric in `AC/Checker.lean` (`ACEquiv.symm`), so it is the
  AC-equivalence relation.

Cyclic rotation and the relator swap are NOT primitive here.  Rotation
`uv ↦ vu` is the conjugation by `u⁻¹` (`Move.cycle` in the checker is
justified by `ACStep.conj₀/conj₁` plus a free step); the swap is not used by
the checker at all: certificates are expanded (by `gen_lean.py`) to explicit
chains ending at the exact target words, using the 6-move swap
`(a,b) → (ab,b) → (ab,b⁻¹) → (ab,b⁻¹ab) → (ab,a) → (aba⁻¹,a) → (b,a)`
written out as ordinary moves.
-/

namespace AC

/-- Letters of the free group F(x, y): `x`, `X = x⁻¹`, `y`, `Y = y⁻¹`. -/
inductive L where
  | x | X | y | Y
  deriving DecidableEq, Repr

/-- Inverse letter. -/
def L.inv : L → L
  | .x => .X
  | .X => .x
  | .y => .Y
  | .Y => .y

@[simp] theorem L.inv_inv (a : L) : a.inv.inv = a := by cases a <;> rfl

/-- Words in F(x, y). -/
abbrev Word := List L

/-- Formal inverse of a word: reverse and invert every letter. -/
def winv (w : Word) : Word := (w.map L.inv).reverse

/-- Free equality: the equivalence relation generated by deleting a
cancelling pair `a a⁻¹` at any position. -/
inductive FreeEq : Word → Word → Prop
  | refl (w : Word) : FreeEq w w
  | cancel (p q : Word) (a : L) : FreeEq (p ++ a :: a.inv :: q) (p ++ q)
  | symm {u v : Word} : FreeEq u v → FreeEq v u
  | trans {u v w : Word} : FreeEq u v → FreeEq v w → FreeEq u w

/-- A balanced presentation `⟨x, y | r₀, r₁⟩` of rank 2: its two relators. -/
abbrev Pres := Word × Word

/-- `pw w true = w`, `pw w false = w⁻¹`. -/
def pw (w : Word) : Bool → Word
  | true => w
  | false => winv w

/-- One Andrews–Curtis move (index 0 = first relator, 1 = second). -/
inductive ACStep : Pres → Pres → Prop
  /-- r₀ ← r₀⁻¹ -/
  | inv₀ (a b : Word) : ACStep (a, b) (winv a, b)
  /-- r₁ ← r₁⁻¹ -/
  | inv₁ (a b : Word) : ACStep (a, b) (a, winv b)
  /-- r₀ ← r₀ r₁^{±1} -/
  | mul₀ (a b : Word) (e : Bool) : ACStep (a, b) (a ++ pw b e, b)
  /-- r₁ ← r₁ r₀^{±1} -/
  | mul₁ (a b : Word) (e : Bool) : ACStep (a, b) (a, b ++ pw a e)
  /-- r₀ ← w r₀ w⁻¹ -/
  | conj₀ (a b w : Word) : ACStep (a, b) (w ++ a ++ winv w, b)
  /-- r₁ ← w r₁ w⁻¹ -/
  | conj₁ (a b w : Word) : ACStep (a, b) (a, w ++ b ++ winv w)
  /-- r₀ replaced by a freely equal word -/
  | free₀ {a a' : Word} (b : Word) : FreeEq a a' → ACStep (a, b) (a', b)
  /-- r₁ replaced by a freely equal word -/
  | free₁ (a : Word) {b b' : Word} : FreeEq b b' → ACStep (a, b) (a, b')

/-- Reflexive–transitive closure. -/
inductive Star {α : Type} (R : α → α → Prop) : α → α → Prop
  | refl (a : α) : Star R a a
  | tail {a b c : α} : Star R a b → R b c → Star R a c

/-- AC-equivalence of rank-2 presentations. -/
def ACEquiv (p q : Pres) : Prop := Star ACStep p q

/-! ## Named presentations, written from their textbook definitions -/

open L

/-- `rep n a = aⁿ` -/
def rep (n : Nat) (a : L) : Word := List.replicate n a

/-- Miller–Schupp `MS(n, w) = ⟨x, y | x⁻¹yⁿx = yⁿ⁺¹, x = w⟩`, with relators
`(x⁻¹ yⁿ x y⁻⁽ⁿ⁺¹⁾, x⁻¹ w)` [Shehper et al. arXiv:2408.15332 §1;
Carreras arXiv:2607.23611 §1]. -/
def MS (n : Nat) (w : Word) : Pres :=
  (X :: rep n y ++ x :: rep (n + 1) Y, X :: w)

/-- Akbulut–Kirby `AK(n) = ⟨x, y | xⁿ = yⁿ⁺¹, xyx = yxy⟩`, relators
`(xⁿ y⁻⁽ⁿ⁺¹⁾, xyx y⁻¹x⁻¹y⁻¹)`. -/
def AK (n : Nat) : Pres :=
  (rep n x ++ rep (n + 1) Y, [x, y, x, Y, X, Y])

/-- Johnson's presentation `⟨x, y | x⁻¹y²x = y³, y⁻¹x²y = x³⟩`
(Carreras' P1 up to rotation), relators `(x⁻¹y²xy⁻³, y⁻¹x²yx⁻³)`. -/
def johnsonP1 : Pres :=
  ([X, y, y, x, Y, Y, Y], [Y, x, x, y, X, X, X])

/-- The trivial presentation `⟨x, y | x, y⟩`. -/
def trivialPres : Pres := ([x], [y])

end AC
